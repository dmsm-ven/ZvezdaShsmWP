// плавное появление секций при скролле
document.querySelectorAll('.section .wrap, .stats .wrap').forEach(function(el){el.classList.add('reveal')});
var io=new IntersectionObserver(function(es){es.forEach(function(en){if(en.isIntersecting){en.target.classList.add('on');io.unobserve(en.target)}})},{threshold:0,rootMargin:'0px 0px -40px 0px'});
function novaRevealVisible(){document.querySelectorAll('.reveal:not(.on)').forEach(function(el){var r=el.getBoundingClientRect();if(r.top<window.innerHeight&&r.bottom>0){el.classList.add('on');io.unobserve(el)}})}
window.addEventListener('load',novaRevealVisible);
setTimeout(novaRevealVisible,600);
setTimeout(function(){document.querySelectorAll('.reveal:not(.on)').forEach(function(el){if(el.getBoundingClientRect().top<window.innerHeight*1.5)el.classList.add('on')})},1800);
document.querySelectorAll('.reveal').forEach(function(el){io.observe(el)});
// видео: клик по превью загружает плеер
var vc=document.getElementById('videoCard');
function playVideo(){
  if(vc.querySelector('iframe'))return;
  var f=document.createElement('iframe');
  f.src='https://www.youtube-nocookie.com/embed/G1t2zkg3k04?autoplay=1&rel=0';
  f.allow='autoplay; encrypted-media; picture-in-picture';
  f.allowFullscreen=true;
  vc.appendChild(f);
}
if(vc){vc.addEventListener('click',playVideo);vc.addEventListener('keydown',function(e){if(e.key==='Enter'||e.key===' '){e.preventDefault();playVideo()}})}
