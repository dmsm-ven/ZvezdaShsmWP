// мобильное меню (генерируется из основного)
(function(){
  var wrap=document.querySelector('.header .wrap'), nav=document.querySelector('.header .nav');
  if(!wrap||!nav)return;
  var burger=document.createElement('button');
  burger.className='burger'; burger.setAttribute('aria-label','Открыть меню');
  burger.innerHTML='<span></span><span></span><span></span>';
  wrap.insertBefore(burger, wrap.querySelector('.cta'));
  var mn=document.createElement('div'); mn.className='mobile-nav';
  mn.innerHTML='<button class="close" aria-label="Закрыть меню">✕</button>'+nav.innerHTML+
    '<div class="mcontacts"><a href="tel:+79856692689">+7 (985) 669-26-89</a> · <a href="https://wa.me/79856692689">WhatsApp</a> · <a href="https://t.me/fcsupernovamoscow">Telegram</a></div>';
  document.body.appendChild(mn);
  burger.addEventListener('click',function(){mn.classList.add('open')});
  mn.querySelector('.close').addEventListener('click',function(){mn.classList.remove('open')});
  mn.querySelectorAll('a').forEach(function(a){a.addEventListener('click',function(){mn.classList.remove('open')})});
})();

// лайтбокс для галерей
(function(){
  var imgs=Array.prototype.slice.call(document.querySelectorAll('.masonry img, .gallery img'));
  if(!imgs.length)return;
  var lb=document.createElement('div'); lb.className='lightbox';
  lb.innerHTML='<button class="lb-close" aria-label="Закрыть">✕</button><button class="lb-prev" aria-label="Предыдущее">‹</button><img alt=""><button class="lb-next" aria-label="Следующее">›</button>';
  document.body.appendChild(lb);
  var im=lb.querySelector('img'), i=0;
  function show(n){i=(n+imgs.length)%imgs.length; im.src=imgs[i].src; im.alt=imgs[i].alt; lb.classList.add('open')}
  imgs.forEach(function(el,n){el.style.cursor='zoom-in'; el.addEventListener('click',function(){show(n)})});
  lb.querySelector('.lb-close').addEventListener('click',function(){lb.classList.remove('open')});
  lb.querySelector('.lb-prev').addEventListener('click',function(){show(i-1)});
  lb.querySelector('.lb-next').addEventListener('click',function(){show(i+1)});
  lb.addEventListener('click',function(e){if(e.target===lb)lb.classList.remove('open')});
  document.addEventListener('keydown',function(e){
    if(!lb.classList.contains('open'))return;
    if(e.key==='Escape')lb.classList.remove('open');
    if(e.key==='ArrowLeft')show(i-1);
    if(e.key==='ArrowRight')show(i+1);
  });
})();

// верхняя полоса «Идёт набор»: закрытие на время сессии
(function(){
  var tb=document.getElementById('topbar');
  if(!tb)return;
  try{ if(sessionStorage.getItem('novaTopbarClosed')==='1'){tb.classList.add('hidden');return} }catch(e){}
  var btn=tb.querySelector('.tb-close');
  if(btn)btn.addEventListener('click',function(){
    tb.classList.add('hidden');
    try{sessionStorage.setItem('novaTopbarClosed','1')}catch(e){}
  });
})();
